#!/usr/bin/env python3
"""平板模式虛擬開關的控制小工具，給 GNOME 按鈕（或手動測試）呼叫用。

用法：
  tablet-mode-toggle SET 1   # 進入平板模式
  tablet-mode-toggle SET 0   # 退出平板模式（回到筆電模式）
  tablet-mode-toggle TOGGLE  # 切換成相反狀態
  tablet-mode-toggle STATUS  # 查詢目前狀態，不改變它

連到 /run/tablet-mode-switch.sock 這個 socket 時，如果背景 daemon 還沒啟動，
systemd 的 socket activation 會自動把它叫起來，呼叫端不用管這件事。
"""
import socket
import sys

SOCK_PATH = "/run/tablet-mode-switch.sock"


def main():
    cmd = " ".join(sys.argv[1:]) if len(sys.argv) > 1 else "TOGGLE"
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.connect(SOCK_PATH)
        s.sendall(cmd.encode())
        print(s.recv(64).decode(errors="replace").strip())


if __name__ == "__main__":
    main()
