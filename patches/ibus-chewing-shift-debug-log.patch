@@ -6,6 +6,25 @@
 #include "ibus-chewing-preedit-private.h"
 #include <chewing.h>
 #include <glib.h>
+#include <stdio.h>
+#include <time.h>
+
+static void shift_debug_log(const char *side, const char *stage, gint64 interval, gboolean dropped) {
+    FILE *f = fopen("/tmp/shift-debug.log", "a");
+    if (!f) return;
+    time_t now = time(NULL);
+    struct tm tmv;
+    localtime_r(&now, &tmv);
+    char ts[32];
+    strftime(ts, sizeof(ts), "%H:%M:%S", &tmv);
+    if (interval >= 0) {
+        fprintf(f, "[%s] %s %s interval=%" G_GINT64_FORMAT " us (%.1f ms) %s\n",
+                ts, side, stage, interval, interval / 1000.0, dropped ? "DROPPED(掉鍵)" : "OK(有切換)");
+    } else {
+        fprintf(f, "[%s] %s %s %s\n", ts, side, stage, dropped ? "DROPPED(掉鍵)" : "OK(有切換)");
+    }
+    fclose(f);
+}
 
